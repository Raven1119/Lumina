		{"id":"edge-eval-replan","fromNode":"supervisor-eval","fromSide":"right","toNode":"local-replan","toSide":"left","color":"2","label":"rᵢ = true"},
		{"id":"edge-context-replan","fromNode":"scoped-context","fromSide":"bottom","toNode":"local-replan","toSide":"top","color":"2","label":"节点边界不变"},
		{"id":"edge-replan-executor","fromNode":"local-replan","fromSide":"right","toNode":"local-executor","toSide":"bottom","color":"2","label":"修订计划 πᵢ′"},
		{"id":"edge-eval-outcome","fromNode":"supervisor-eval","fromSide":"bottom","toNode":"node-outcome","toSide":"top","color":"2","label":"completed / failed"},
