# Copy to .env.local; keep real credentials private. Process environment wins.
LUMINA_MODEL_MODE=mock
DEEPSEEK_API_KEY=replace-with-local-secret
# config/model.toml sets the default model and optional per-role selections.
# Optional global override for roles without a role selection: LUMINA_MODEL=deepseek-v4-pro
# Optional role overrides: LUMINA_CHAT_MODEL, LUMINA_MIND_MODEL,
# LUMINA_ANALYSIS_MODEL, LUMINA_EXECUTION_MODEL, LUMINA_MEMORY_MODEL.

# Chat reads memory every enabled turn; the read is local and fail-soft.
LUMINA_CONVERSATION_MEMORY_RECALL_ENABLED=true
LUMINA_DRAFT_STORE_PATH=data/draft/hot_drafts.jsonl
LUMINA_DEFAULT_TIMEZONE=Asia/Shanghai

# Memory v1 SQLite, embedding cache, and model-response cache.
LUMINA_MEMORY_DIR=data/memory_v1
LUMINA_DREAM_TRIGGER_TURNS=40
# Optional local BGE-M3 snapshot path (fixed revision and weights required).
# LUMINA_EMBED_MODEL_PATH=/absolute/path/to/bge-m3-snapshot
