# Lumina Chat configuration (core/main.py and core/model_client.py).
# Copy to .env.local. Never commit real credentials.

# Default mode is mock. Change to real with a DeepSeek API key.
LUMINA_MODEL_MODE=mock
DEEPSEEK_API_KEY=replace-with-local-secret

# Explicit production Recall switch. Source/fresh-install default is on.
LUMINA_CONVERSATION_MEMORY_RECALL_ENABLED=true

# Hot Draft path. Cold Draft and compaction state use the same directory.
LUMINA_DRAFT_STORE_PATH=data/draft/hot_drafts.jsonl

# Mind decision audit log path (append-only JSONL).
LUMINA_MIND_DECISION_LOG_PATH=data/mind/decisions.jsonl

# Chat read mode: llm (default boolean gate), constant (always recall),
# direct (explicit read-first), select (explicit post-read evidence selection).
# In llm/constant modes, mock clients use the constant gate.
# Candidate comparison conditions: docs/EXPERIMENTS.md.
LUMINA_MIND_GATE_MODE=llm

# USER_SELF query binding / legacy BGE entity projection. Source default on.
# The configured real-model default is v6 + FirstHit + reliable-v2 (no BGE).
LUMINA_USER_SELF_BINDING_ENABLED=true

# Optional existing path overrides. Keep experiments in fresh external directories.
# Shared app/Dream MAGMA path (core/main.py, Dream/runner.py):
# LUMINA_DREAM_MAGMA_PERSIST_DIR=data/conversation_memory/magma
# Dream CLI only; app Cold path follows the Hot Draft parent directory:
# LUMINA_DREAM_COLD_DRAFT_PATH=data/draft/cold_drafts.jsonl
# LUMINA_DREAM_INGESTION_STATE_PATH=data/conversation_memory/ingestion_state.json
# Turn provenance fallback (core/main.py):
# LUMINA_DEFAULT_TIMEZONE=UTC
# Cognitive-chain state/workspace/budgets are explicit python -m Mind arguments.
