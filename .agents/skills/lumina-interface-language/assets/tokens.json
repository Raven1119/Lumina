  "fonts": {
    "sans": "\"Noto Sans CJK SC\",\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif",
    "serif": "\"Noto Serif CJK SC\",\"Songti SC\",\"STSong\",\"SimSun\",serif",
    "mono": "\"SFMono-Regular\",Consolas,\"Liberation Mono\",monospace"
  },
  "type": {
    "bodyPx": 16,
    "bodyLineHeight": 1.85,
    "smallPx": 12,
    "displayLineHeight": 1.5
  },
  "spacingPx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radiusPx": 2,
  "motion": {
    "source": "research-interface-language@1.0.0 / V9",
    "easing": "cubic-bezier(.215,.61,.355,1)",
    "enter": {
      "durationMs": 600,
      "distancePx": 24
    },
    "pixel": {
      "gridSize": 12,
      "coverMs": 300,
      "revealMs": 300
    },
    "cursor": {
      "captureMs": 200,
      "returnMs": 300
    },
    "split": {
      "durationMs": 650,
      "staggerMs": 30,
      "distancePx": 40
    },
    "decrypt": {
      "stepMs": 40
    },
    "type": {
      "stepMs": 25
    },
    "scramble": {
      "radiusPx": 65,
      "intervalMs": 65,
      "durationMaxMs": 1200
    },
    "elastic": {
      "returnMs": 440,
      "min": 0.15,
      "max": 1.5,
      "default": 0.8
    },
    "stepper": {
      "durationMs": 400,
      "enterPercent": -100,
      "exitPercent": 50
    }
  }
}
